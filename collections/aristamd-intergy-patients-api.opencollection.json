{
  "opencollection": "1.0.0",
  "info": {
    "name": "Arista MD Intergy/Patients API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Intergy/Patients",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves Patient information from Intergy API",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/intergy/patients/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Patient's Id"
              },
              {
                "name": "practice_id",
                "value": "",
                "type": "query",
                "description": "Id of the practice we want to search"
              }
            ]
          },
          "docs": "Retrieves Patient Record, if the patient was already included then we are goin to update patient's information,if not then we are going to return a new patient record."
        }
      ]
    }
  ],
  "bundled": true
}